// Configuration du client Prisma
generator client {
  provider = "prisma-client-js"
}

// Connexion à la base de données (PostgreSQL)
datasource db {
  provider = "postgresql"
}

// =====================================================================
// 🏢 PHASE 1 : LE VRAI MODÈLE B2B (MULTI-TENANT)
// =====================================================================
model Company {
  id                   String                @id @default(cuid())
  name                 String
  plan                 String                @default("trial") // trial, starter, growth, enterprise
  createdAt            DateTime              @default(now())
  
  users                User[]
  verificationRequests VerificationRequest[]
  auditLogs            AuditLog[]            // 💡 AJOUT : L'entreprise possède désormais son registre global
}
  // Préparation Phase 4 (L'écosystème Développeur B2B)
  // apiKeys              ApiKey[]
  // webhooks             Webhook[]


// =====================================================================
// 🧑‍💻 UTILISATEURS ET IAM (IDENTITY & ACCESS MANAGEMENT)
// =====================================================================
model User {
  id                   String                @id @default(cuid())
  fullName             String
  companyName          String?               // Gardé temporairement pour ne pas casser l'ancien code
  
  // 🏢 RELATION ENTREPRISE
  companyId            String?
  company              Company?              @relation(fields: [companyId], references: [id])
  
  // 🛡️ SÉCURITÉ & RÔLES (Phase 2 & 4)
  role                 String                @default("AGENT") // SUPER_ADMIN, COMPANY_ADMIN, AGENT, AUDITOR
  
  email                String                @unique
  password             String?
  avatarUrl            String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt 
  
  // 🔐 WEBAUTHN / PASSKEYS
  currentChallenge     String?
  passkeys             Passkey[]
  
  // 📱 2FA TOTP (Préparation Phase 2)
  totpEnabled          Boolean               @default(false)
  totpSecret           String?               // ⚠️ Devra être chiffré
  backupCodes          String?               // Codes de secours stockés hashés
  
  verificationRequests VerificationRequest[]
  auditLogs            AuditLog[]            
  userSessions         UserSession[]         
}

// =====================================================================
// 📁 MOTEUR KYC : DOSSIERS CLIENTS
// =====================================================================
model VerificationRequest {
  id           String   @id @default(cuid())
  customerName String
  email        String  
  type         String   
  status       String   @default("pending") // pending, verified, rejected
  
  cin          String   
  documentType String   @default("CIN")
  nationality  String?
  dateOfBirth  String?
  phoneNumber  String?

  idCardUrl    String?
  selfieUrl    String?

  score        String?  
  riskLevel    String?  
  aiRationale  String?  

  submittedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt 

  // 🏢 ISOLATION DES DONNÉES (Le dossier appartient à l'entreprise)
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // ⚖️ CONFORMITÉ LÉGALE (SetNull au lieu de Cascade)
  // Le dossier KYC doit survivre si l'agent est supprimé de la BDD.
  userId       String?  
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  auditLogs    AuditLog[] 
}

// =====================================================================
// 📜 PISTE D'AUDIT (OBLIGATOIRE EN COMPLIANCE)
// =====================================================================
model AuditLog {
  id          String   @id @default(cuid())
  action      String   
  details     String?  
  timestamp   DateTime @default(now())

  // 💡 NOUVEAU : Centralisation B2B obligatoire (Tout log appartient à l'entreprise)
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // 💡 CORRECTION : Rendu optionnel (?) car un log de Login n'a pas de dossier KYC !
  requestId   String?
  request     VerificationRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  agentId     String?
  agent       User?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
}

// =====================================================================
// 💻 SESSIONS DYNAMIQUES
// =====================================================================
model UserSession {
  id           String   @id @default(cuid())
  userAgent    String   
  deviceType   String   
  ipAddress    String   
  isActive     Boolean  @default(true) 
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now()) @updatedAt

  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =====================================================================
// 🔑 CRYPTOGRAPHIE : PASSKEYS
// =====================================================================
model Passkey {
  id                  String   @id @default(cuid())
  credentialID        String   @unique 
  credentialPublicKey Bytes    
  counter             Int      
  transports          String?  
  
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt           DateTime @default(now())
  lastUsedAt          DateTime @default(now())
}