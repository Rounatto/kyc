// ============================================================================
// 🗺️ SCHÉMA DE DONNÉES — TRUSTVERIFY (KYC B2B MULTI-TENANT)
// ============================================================================
// Vue d'ensemble de l'architecture : `Company` est la racine du multi-tenant —
// PRESQUE tous les autres modèles portent un `companyId` pour garantir que les
// données d'une entreprise cliente ne sont jamais visibles par une autre
// (le cloisonnement est appliqué au niveau applicatif via lib/rbac.ts, pas par
// des policies Postgres — chaque requête Prisma doit filtrer par companyId).
//
// Convention de suppression en cascade utilisée dans ce schéma :
// - onDelete: Cascade → l'enfant n'a aucun sens sans son parent (ex: un dossier
//   KYC sans entreprise), donc il est supprimé avec elle.
// - onDelete: SetNull → l'enfant doit SURVIVRE à la suppression du parent pour
//   des raisons légales/traçabilité (ex: un AuditLog ou un dossier KYC doit
//   rester consultable même si l'agent qui l'a traité quitte l'entreprise).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =====================================================================
// 🏢 PHASE 1 : LE VRAI MODÈLE B2B (MULTI-TENANT)
// =====================================================================
model Company {
  id                   String                @id @default(cuid())
  name                 String
  plan                 String                @default("trial") // trial, starter, growth, enterprise
  createdAt            DateTime              @default(now())

  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean               @default(false)

  // 💳 LIEN VERS STRIPE
  // Sans ces deux identifiants, l'annulation ne pouvait exister QUE dans notre
  // base : on posait `cancelAtPeriodEnd = true` sans jamais prévenir Stripe,
  // qui continuait donc à facturer le client — et surtout, il devenait
  // impossible de "reprendre" l'abonnement puisqu'on n'avait aucune référence
  // à l'objet Subscription à réactiver. Ces champs sont nullables car les
  // entreprises créées avant cette évolution (ou passées en plan payant
  // manuellement) n'en ont pas : le code doit toujours prévoir un repli
  // "DB seule" quand ils sont absents.
  stripeCustomerId     String?
  stripeSubscriptionId String?

  users                User[]
  verificationRequests VerificationRequest[]
  auditLogs            AuditLog[]            
  
  // L'écosystème Développeur
  apiKeys              ApiKey[]

  // Les notifications de l'entreprise
  notifications        Notification[]
}

// =====================================================================
// 🧑‍💻 UTILISATEURS ET IAM (IDENTITY & ACCESS MANAGEMENT)
// =====================================================================
model User {
  id                   String                @id @default(cuid())
  fullName             String
  companyName          String?               
  
  // 🏢 RELATION ENTREPRISE
  companyId            String?
  company              Company?              @relation(fields: [companyId], references: [id])
  
  // 🛡️ SÉCURITÉ & RÔLES
  role                 String                @default("AGENT") 
  
  email                String                @unique
  password             String?
  avatarUrl            String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt 
  
  // 🔐 WEBAUTHN / PASSKEYS
  currentChallenge     String?
  passkeys             Passkey[]
  
  // 📱 2FA TOTP
  // ⚠️ totpSecret n'est plus stocké EN CLAIR (chiffré)
  // backupCodes existe dans le schéma mais rien ne le génère actuellement côté API.
  totpEnabled          Boolean               @default(false)
  totpSecret           String?
  backupCodes          String?
  
  // INVITATION SÉCURISÉE B2B
  invitationToken      String?               @unique
  invitationExpires    DateTime?

  // 💡 NOUVEAU : Préférences de routage des e-mails (Settings)
  emailNotifSuccess    Boolean               @default(false)
  emailNotifAlerts     Boolean               @default(true)
  emailNotifWeekly     Boolean               @default(false)

  verificationRequests VerificationRequest[]
  auditLogs            AuditLog[]            
  userSessions         UserSession[] 

  // Clés API générées par cet utilisateur        
  createdApiKeys       ApiKey[]

  // Notifications ciblées pour cet utilisateur
  notifications        Notification[]
}

// =====================================================================
// 📁 MOTEUR KYC : DOSSIERS CLIENTS
// =====================================================================
model VerificationRequest {
  id           String   @id @default(cuid())
  customerName String
  email        String  
  type         String   
  status       String   @default("pending") // pending, verified, rejected
  
  cin          String   
  documentType String   @default("CIN")
  nationality  String?
  dateOfBirth  String?
  phoneNumber  String?

  idCardUrl    String?
  selfieUrl    String?

  score        String?  
  riskLevel    String?  
  aiRationale  String?  

  submittedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt 

  // 🏢 ISOLATION DES DONNÉES (Le dossier appartient à l'entreprise)
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // ⚖️ CONFORMITÉ LÉGALE (SetNull au lieu de Cascade)
  userId       String?  
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  auditLogs    AuditLog[] 
}

// =====================================================================
// 📜 PISTE D'AUDIT (OBLIGATOIRE EN COMPLIANCE)
// =====================================================================
model AuditLog {
  id          String   @id @default(cuid())
  action      String   
  details     String?  
  timestamp   DateTime @default(now())

  // Centralisation B2B obligatoire
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  requestId   String?
  request     VerificationRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  agentId     String?
  agent       User?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
}

// =====================================================================
// 💻 SESSIONS DYNAMIQUES
// =====================================================================
model UserSession {
  id           String   @id @default(cuid())
  userAgent    String   
  deviceType   String   
  ipAddress    String   
  isActive     Boolean  @default(true) 
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now()) @updatedAt

  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =====================================================================
// 🔑 CRYPTOGRAPHIE : PASSKEYS
// =====================================================================
model Passkey {
  id                  String   @id @default(cuid())
  credentialID        String   @unique 
  credentialPublicKey Bytes    
  counter             Int      
  transports          String?  
  
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt           DateTime @default(now())
  lastUsedAt          DateTime @default(now())
}

// =====================================================================
// 📩 ONBOARDING SÉCURISÉ : VÉRIFICATION OTP (Phase 6)
// =====================================================================
model OtpCode {
  id        String   @id @default(cuid())
  // @unique sur l'email : un seul code actif par adresse à la fois — générer un
  // nouveau code écrase (upsert) l'ancien plutôt que d'en accumuler plusieurs.
  email     String   @unique
  code      String   // Le code à 6 chiffres
  expiresAt DateTime // Date d'expiration (ex: dans 10 minutes)
  createdAt DateTime @default(now())
}

// =====================================================================
// 🔌 ÉCOSYSTÈME B2B : API KEYS (Phase 9)
// =====================================================================
model ApiKey {
  id          String   @id @default(cuid())
  name        String   // Ex: "Serveur de Production NodeJS"
  // ⚠️ Clé stockée EN CLAIR (ex: tv_live_xxx). Idéalement on stockerait un hash
  // SHA-256 + un préfixe affichable, pour qu'une fuite de DB ne compromette pas
  // les clés API des clients (voir roadmap Phase D).
  key         String   @unique
  lastUsedAt  DateTime? // Pour savoir si elle est active
  createdAt   DateTime @default(now())

  // Apparentée à l'entreprise
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Créée par un admin
  createdBy   String
  user        User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)
}

// =====================================================================
// 🔔 MOTEUR DE NOTIFICATIONS (Phase 11)
// =====================================================================
model Notification {
  id          String   @id @default(cuid())
  type        String   // Ex: "HIGH_RISK_ALERT", "SYSTEM", "SUCCESS", "BILLING"
  title       String
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  // La notification appartient au Workspace (Entreprise)
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Optionnel : Lié à un utilisateur spécifique
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}