// Configuration du client Prisma
generator client {
  provider = "prisma-client-js"
}

// Connexion à la base de données (PostgreSQL)
datasource db {
  provider = "postgresql"
  // 💡 L'URL n'est plus requise ici sous Prisma 7+, elle est gérée par ton prisma.config.ts
}

// Table Utilisateur
model User {
  id                   String                @id @default(cuid())
  fullName             String
  companyName          String?               // 💡 DEVENU OPTIONNEL POUR GOOGLE
  email                String                @unique
  password             String?               // 💡 DEVENU OPTIONNEL POUR GOOGLE
  avatarUrl            String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt 
  
  // 💡 SÉCURITÉ WEBAUTHN : Le défi temporaire envoyé par le serveur pour valider l'empreinte
  currentChallenge     String?
  
  verificationRequests VerificationRequest[]
  auditLogs            AuditLog[]            
  userSessions         UserSession[]         
  passkeys             Passkey[]             // 💡 RELATION : Les clés biométriques de l'utilisateur
}

// Table Principale (Les dossiers clients soumis)
model VerificationRequest {
  id           String   @id @default(cuid())
  customerName String
  email        String  
  type         String   
  status       String   @default("pending") // pending, verified, rejected
  
  cin          String   
  documentType String   @default("CIN")
  nationality  String?
  dateOfBirth  String?
  phoneNumber  String?

  // Section Fichiers (Pour UploadThing / Supabase)
  idCardUrl    String?
  selfieUrl    String?

  // Section Décision IA 
  score        String?  
  riskLevel    String?  // ex: Low, Medium, High
  aiRationale  String?  // Explication textuelle de l'IA

  submittedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt 

  // Relation : l'agent propriétaire du dossier
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Relation : l'historique des actions sur ce dossier
  auditLogs    AuditLog[] 
}

// Table Historique (La Piste d'Audit obligatoire en finance/KYC)
model AuditLog {
  id          String   @id @default(cuid())
  action      String   // Ex: CREATED, APPROVED, REJECTED
  details     String?  // Ex: "Validé suite à un appel" ou "Rejeté par IA"
  timestamp   DateTime @default(now())

  // Le dossier concerné
  requestId   String
  request     VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  // L'agent qui a cliqué (Optionnel si c'est l'IA qui agit)
  agentId     String?
  agent       User?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
}

// Table de traçabilité des appareils et sessions actives
model UserSession {
  id           String   @id @default(cuid())
  userAgent    String   // Contient la chaîne brute du navigateur pour l'analyse
  deviceType   String   // Stocke le résultat propre : Windows PC, iOS iPhone, Android, etc.
  ipAddress    String   // Adresse IP de connexion
  isActive     Boolean  @default(true) // Permet la révocation à distance
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now()) @updatedAt

  // Relation vers l'utilisateur propriétaire de la session
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 💡 NOUVEAU [SÉCURITÉ] : Table pour stocker les clés biométriques (WebAuthn / Passkeys)
model Passkey {
  id                  String   @id @default(cuid())
  credentialID        String   @unique // L'identifiant unique généré par l'appareil
  credentialPublicKey Bytes    // La clé cryptographique publique (format binaire)
  counter             Int      // Sécurité anti-clonage (compteur d'utilisation)
  transports          String?  // Ex: "internal" (FaceID/TouchID), "usb" (Clé Yubikey)
  
  // Le propriétaire de cette empreinte
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt           DateTime @default(now())
  lastUsedAt          DateTime @default(now())
}