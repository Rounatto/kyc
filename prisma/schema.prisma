generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String                @id @default(cuid())
  fullName            String
  companyName         String
  email               String                @unique
  password            String
  avatarUrl           String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @default(now()) @updatedAt
  // 🔗 Lien de relation : Un utilisateur a plusieurs demandes
  verificationRequests VerificationRequest[] 
}

model VerificationRequest {
  id          String   @id @default(cuid())
  customerName String   // Nom du client (ex: Eleanor Lewis)
  email       String   // Email du client
  type        String   // Type de vérification (ex: Individual KYC, Corporate KYB)
  status      String   @default("pending") // status: verified, pending, rejected
  score       String   @default("--")      // Score de risque (ex: 98/100)
  submittedAt DateTime @default(now())
  
  // 🔗 Configuration de la relation avec l'User Admin
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}