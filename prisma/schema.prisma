generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  fullName      String
  companyName   String
  email         String    @unique
  password      String
  avatarUrl     String?   
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt // L'astuce est d'ajouter @default(now()) ici !
}