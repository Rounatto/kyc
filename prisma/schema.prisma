generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Plus RIEN ici concernant l'URL
}

model User {
  id          String   @id @default(cuid())
  fullName    String?  
  companyName String?  
  email       String   @unique
  password    String   
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}