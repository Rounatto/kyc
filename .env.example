# ============================================================================
# TrustVerify — Variables d'environnement (modèle)
# ----------------------------------------------------------------------------
# Copie ce fichier en .env.local et remplace chaque placeholder par une vraie
# valeur. NE COMMITE JAMAIS de vrais secrets — ce fichier ne sert qu'à
# documenter quelles variables sont nécessaires pour faire tourner le projet.
# ============================================================================

# --- Base de données (PostgreSQL / Supabase) ---
# URL de connexion Prisma. En production serverless, utilise le pooler (port 6543).
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# --- NextAuth (authentification) ---
# URL publique de l'app, utilisée par NextAuth pour les callbacks.
NEXTAUTH_URL="http://localhost:3000"
# Secret utilisé pour signer les tokens de session JWT. OBLIGATOIRE en prod.
# Génère-le avec : openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# --- Google OAuth ---
# Depuis Google Cloud Console > APIs & Services > Credentials.
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --- WebAuthn / Passkeys ---
# En dev : "localhost". En prod : ton vrai domaine (ex: "trustverify.tn").
WEBAUTHN_RPID="localhost"
# En dev : "http://localhost:3000". En prod : "https://ton-domaine.com".
WEBAUTHN_ORIGIN="http://localhost:3000"

# --- Supabase (stockage des fichiers : avatars, documents, selfies) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# Clé service-role (côté serveur uniquement, JAMAIS exposée au client).
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# --- Stripe (facturation) ---
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
# Secret de vérification des webhooks Stripe (depuis le dashboard Stripe).
STRIPE_WEBHOOK_SECRET="whsec_your-stripe-webhook-secret"

# --- Email (Nodemailer via Gmail) ---
# Adresse Gmail utilisée pour envoyer les emails transactionnels.
EMAIL_USER="your-email@gmail.com"
# Mot de passe d'application Gmail (PAS ton mot de passe habituel).
# À générer dans : Compte Google > Sécurité > Mots de passe des applications.
EMAIL_APP_PASSWORD="your-gmail-app-password"

# --- OpenSanctions (screening AML / PEP) ---
OPENSANCTIONS_API_KEY="your-opensanctions-api-key"

# --- Gemini (chat support IA) ---
GEMINI_API_KEY="your-gemini-api-key"

# --- Cron (Vercel) ---
# Secret partagé pour authentifier les appels du cron Vercel.
# Génère-le avec : openssl rand -hex 32
CRON_SECRET="replace-with-a-long-random-string"

# --- URL publique de l'app (utilisée côté client) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"